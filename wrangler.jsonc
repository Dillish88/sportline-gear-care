{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sportline-gear-care-phase1",
  "preview_urls": true,
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./cloudflare-dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/", "/index.html", "/pilot/*", "/concept*", "/gear-care.html", "/stringing.html"]
  },
  "triggers": {
    "crons": ["30 4 * * *"]
  },
  "previews": {}
}
